{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Cache": {
    "UseMemory": false
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Keycloak": {
    "Authority": "http://localhost:8180/realms/todo-platform",
    "Audience": "todo-api",
    "RequireHttpsMetadata": false
  },
  "RabbitMq": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "todo",
    "Password": "todo"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "From": "todo-platform@localhost"
  },
  "AllowedHosts": "*"
}
