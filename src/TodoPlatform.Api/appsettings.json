{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Cache": {
    "UseMemory": false
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/todo-platform",
    "Audience": "todo-api",
    "RequireHttpsMetadata": false
  },
  "AllowedHosts": "*"
}
