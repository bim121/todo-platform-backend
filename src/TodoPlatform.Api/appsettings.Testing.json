{
  "Database": {
    "UseInMemory": true,
    "InMemoryName": "TodoPlatformIntegrationTests",
    "AutoMigrate": false
  },
  "Cache": {
    "UseMemory": true
  },
  "SignalR": {
    "UseRedisBackplane": false
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/todo-platform",
    "Audience": "todo-api",
    "RequireHttpsMetadata": false
  },
  "RabbitMq": {
    "Enabled": false
  },
  "Smtp": {
    "Enabled": false
  }
}
