# Copy to `.env` and adjust. Compose loads these automatically.
#   cp .env.example .env

# --- Host ports ---
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
KEYCLOAK_PORT=8180
REDIS_COMMANDER_PORT=8081
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Postgres ---
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=tododb

# --- RabbitMQ ---
RABBITMQ_USER=todo
RABBITMQ_PASSWORD=todo

# --- Keycloak admin ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8180

# Public issuer in JWT (browser / host). Must match Keycloak KC_HOSTNAME + port.
KEYCLOAK_AUTHORITY=http://localhost:8180/realms/todo-platform
# Discovery URL from inside the API container (Docker DNS). Leave empty when API runs on host.
KEYCLOAK_METADATA_ADDRESS=http://keycloak:8080/realms/todo-platform/.well-known/openid-configuration
KEYCLOAK_AUDIENCE=todo-api

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
DATABASE_AUTO_MIGRATE=true
CORS_ORIGIN=http://localhost:4200
SMTP_ENABLED=false
